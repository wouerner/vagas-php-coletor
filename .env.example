LINKEDIN_EMAIL=seu-email@exemplo.com
LINKEDIN_PASSWORD='sua-senha'

# --- Base de dados (MySQL 8) --------------------------------------------------
# No docker-compose.yml local o MySQL sobe junto e DATABASE_URL já vem pronta (só a
# senha muda, com MYSQL_PASSWORD). Fora dele, ou no Coolify, aponte para o servidor:
# DATABASE_URL=mysql://usuario:senha@host:3306/base
# Banco gerenciado (Vultr, RDS...): acrescente ?ssl-mode=REQUIRED
# MYSQL_PASSWORD=vagas

# --- Vagas PHP ---------------------------------------------------------------
# Ajustes feitos via MCP (configure_scheduler) ficam em data/config.json e têm
# precedência sobre estes valores.

# Só vagas publicadas há no máximo N horas (coleta, site, API e MCP)
VAGAS_MAX_AGE_HOURS=72

# Site acessível pela rede (IP do servidor). Use 127.0.0.1 para só localhost.
WEB_BIND=0.0.0.0

# Vagas do LinkedIn (busca pública, sem login)
VAGAS_LINKEDIN_KEYWORDS=php,laravel,symfony,wordpress,magento,drupal
VAGAS_LINKEDIN_LOCATIONS=Brasil
VAGAS_LINKEDIN_INTERVAL_HOURS=3

# Vagas da Gupy (portal.gupy.io, sem login). A busca é só no título: termos amplos
# trazem vagas PHP sem "PHP" no título, e o filtro decide pela descrição.
VAGAS_GUPY_TERMS=php,laravel,symfony,wordpress,magento,drupal,desenvolvedor,desenvolvedora,backend,full stack
VAGAS_GUPY_INTERVAL_HOURS=2

# Vagas da Sólides (vagas.solides.com.br, sem login). A busca olha título e descrição.
VAGAS_SOLIDES_ENABLED=true
VAGAS_SOLIDES_TERMS=php,laravel,symfony,codeigniter,wordpress,magento,drupal
VAGAS_SOLIDES_INTERVAL_HOURS=2

# Vagas da Catho (catho.com.br, sem login).
VAGAS_CATHO_ENABLED=true
VAGAS_CATHO_TERMS=php,laravel,symfony,codeigniter,wordpress,magento,drupal
VAGAS_CATHO_INTERVAL_HOURS=3

# Vagas da Remotar (remotar.com.br, vagas 100% remotas, API sem login).
VAGAS_REMOTAR_ENABLED=true
VAGAS_REMOTAR_TERMS=php,laravel,symfony,wordpress,magento,drupal
VAGAS_REMOTAR_INTERVAL_HOURS=2

# Vagas da Programathor (programathor.com.br, sem login): listas por tecnologia.
VAGAS_PROGRAMATHOR_ENABLED=true
VAGAS_PROGRAMATHOR_PAGES=jobs-php,jobs-laravel,jobs-symfony,jobs-codeigniter,jobs-wordpress,jobs-magento,jobs-drupal
VAGAS_PROGRAMATHOR_INTERVAL_HOURS=3

# Vagas da Coodesh (coodesh.com, sem login): sitemap com todas as vagas abertas.
VAGAS_COODESH_ENABLED=true
VAGAS_COODESH_INTERVAL_HOURS=3

# Vagas da Nerdin (nerdin.com.br, portal de vagas de TI, sem login): busca por termo.
VAGAS_NERDIN_ENABLED=true
VAGAS_NERDIN_TERMS=php,laravel,symfony,codeigniter,wordpress,magento,drupal
VAGAS_NERDIN_INTERVAL_HOURS=3

# Vagas do portal da Recrutei (empregos.recrutei.com.br, sem login): sitemap de vagas.
VAGAS_RECRUTEI_ENABLED=true
VAGAS_RECRUTEI_INTERVAL_HOURS=3

# Vagas da UpVagas (upvagas.com.br, vagas remotas, API do WordPress sem login).
VAGAS_UPVAGAS_ENABLED=true
VAGAS_UPVAGAS_TERMS=php,laravel,symfony,codeigniter,wordpress,magento,drupal
VAGAS_UPVAGAS_INTERVAL_HOURS=2

# Vagas de empresas que usam a InHire (<empresa>.inhire.app/vagas, sem login). Não há
# busca entre empresas: liste-as aqui (o nome é o subdomínio). Empresas citadas em links
# .inhire.app nas vagas e posts coletados entram sozinhas.
VAGAS_INHIRE_ENABLED=true
VAGAS_INHIRE_TENANTS=tqi,atlastechnol,clinicaexperts,objective,sympla,db1,zappts,lyncas,bixtecnologia,programmers,jump,orizon,dock,rentbrella,edge,ninecon,mambape
VAGAS_INHIRE_INTERVAL_HOURS=2

# Publicações do LinkedIn anunciando vagas (usa o login; intervalo longo protege a conta)
VAGAS_POSTS_ENABLED=true
VAGAS_POSTS_KEYWORDS=vaga php,vaga laravel,desenvolvedor php,pessoa desenvolvedora php,oportunidade php,vaga wordpress
VAGAS_POSTS_PER_QUERY=15
VAGAS_POSTS_INTERVAL_HOURS=8
VAGAS_POSTS_ACTIVE_HOURS=8-22

# Issues de repositórios de vagas no GitHub (token opcional: aumenta o limite da API)
VAGAS_GITHUB_REPOS=phpdevbr/vagas,backend-br/vagas
VAGAS_GITHUB_INTERVAL_HOURS=1
GITHUB_TOKEN=

# Post diário no LinkedIn (sua conta, sessão do bot): print do dashboard + resumo do dia,
# terminando com "Deus seja Louvado". Dias: 0 = segunda ... 6 = domingo ("0-6", "0-4").
VAGAS_LINKEDIN_DAILY_POST=false
VAGAS_LINKEDIN_POST_TIME=09:00
VAGAS_LINKEDIN_POST_DAYS=0-6
